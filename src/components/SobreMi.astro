
---
import { CONTENT } from "../data/content";
---

<section id="sobre-mi" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto">
            <span class="flex w-fit mx-auto px-3 py-1 rounded-full bg-gp-lavenderLight text-purple-800 text-xs font-bold uppercase tracking-wider mb-5">
                {CONTENT.sobreMi.etiqueta}
            </span>
            <article class="bg-white p-8 sm:p-10 rounded-3xl border border-slate-200 text-center soft-shadow-hover">
                <div class="w-32 h-32 mx-auto mb-5 rounded-full overflow-hidden border-4 border-gp-lavenderLight bg-gradient-to-br from-gp-pinkLight via-gp-lavenderLight to-gp-sageLight flex items-center justify-center">
                    <img src={CONTENT.sobreMi.imagen.src} alt={CONTENT.sobreMi.imagen.alt} class="w-full h-full object-cover object-top scale-[1.7] origin-top">
                </div>
                <h3 class="text-2xl font-bold text-slate-900">{CONTENT.sobreMi.nombre}</h3>
                <p class="text-xs font-bold text-purple-700 uppercase tracking-wide mt-1 mb-5">{CONTENT.sobreMi.rol}</p>
                <div class="text-slate-600 text-sm leading-relaxed space-y-4 text-left">
                    {CONTENT.sobreMi.biografia.map((parrafo) => <p>{parrafo}</p>)}
                </div>
                <div class="flex justify-center gap-3 text-slate-400 mt-6 pt-5 border-t border-slate-100">
                    <a href={CONTENT.contacto.instagram.url} target="_blank" rel="noopener noreferrer" aria-label="Instagram de Piromanía" class="hover:text-slate-900 transition-colors">
                        <i class="fa fa-instagram text-lg"></i>
                    </a>
                    <a href={`mailto:${CONTENT.contacto.correo}`} aria-label="Enviar correo electrónico" class="hover:text-slate-900 transition-colors">
                        <i class="fa fa-envelope text-lg"></i>
                    </a>
                </div>
            </article>
        </div>
    </div>
</section>