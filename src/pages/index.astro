---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Inicio from '../components/Inicio.astro'
import Talleres from '../components/Talleres.astro'
import Calendario from '../components/Calendario.astro'
import Resultados from '../components/Resultados.astro'
import SobreMi from '../components/SobreMi.astro'
import Contacto from '../components/Contacto.astro'
import Footer from '../components/Footer.astro'
import "../styles/main.css";
---
<Layout 
    title="Piromanía — Talleres Artísticos y Expresión Creativa" 
    description="Talleres artísticos y de expresión creativa en Santiago de Chile. Escultura, papel maché y entrenamiento vocal para jóvenes y adultos.">

    <Header /> 

    <main>

        <Inicio />
        <Talleres />
        <Calendario />
        <Resultados />
        <SobreMi />
        <Contacto />
  
    </main>

    <Footer /> 

</Layout>
