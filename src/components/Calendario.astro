
---
import { CONTENT } from "../data/content";

const eventos = CONTENT.calendario.eventos.map((evento) => {
	const taller = CONTENT.talleres.listado.find(
		(item) => item.id === evento.tallerId,
	);

	if (!taller) {
		throw new Error(`No se encontró el taller "${evento.tallerId}" para el calendario.`);
	}

	return { ...evento, taller };
});

const coloresFecha = {
	pink: "bg-gp-pinkLight",
	sage: "bg-gp-sageLight",
	lavender: "bg-gp-lavenderLight",
	yellow: "bg-gp-yellowLight",
};
---

<section id="calendario" class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-5 space-y-4">
                <span class="px-3 py-1 rounded-full bg-gp-yellowLight text-amber-900 text-xs font-bold uppercase tracking-wider">
                    {CONTENT.calendario.etiqueta}
                </span>
                <h2 class="mt-6 text-3xl sm:text-4xl font-extrabold text-slate-900">{CONTENT.calendario.titulo}</h2>
                <p class="text-slate-600">
                    {CONTENT.calendario.descripcion}
                </p>
                <div class="p-4 bg-white rounded-2xl border border-slate-200 text-sm text-slate-700 flex items-start gap-3">
                    <i class="fa fa-info-circle text-gp-sage text-lg mt-0.5"></i>
                    <span>{CONTENT.calendario.nota}</span>
                </div>
            </div>

            <div class="lg:col-span-7 space-y-4">
                {eventos.map((evento) => (
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4 soft-shadow-hover">
                        <div class="flex items-center gap-4">
                            <div class={`min-w-14 h-14 px-2 rounded-2xl ${coloresFecha[evento.color]} text-slate-900 flex flex-col items-center justify-center font-extrabold leading-tight shrink-0`}>
                                <span class="text-xs uppercase font-semibold text-slate-600">{evento.mes}</span>
                                <span class="text-lg">{evento.dias}</span>
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-900">{evento.titulo}</h3>
                                <p class="text-xs text-slate-500">{evento.resumen}</p>
                            </div>
                        </div>
                        <div class="flex items-center justify-between sm:justify-end gap-4">
                            <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold">{evento.taller.cupos} cupos</span>
                            <button
                                type="button"
                                data-workshop-details={evento.taller.detalleId}
                                data-workshop-title={evento.titulo}
                                class="px-4 py-2 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-slate-800 transition-colors"
                            >
                                Ver detalles
                            </button>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>