---
import "../styles/main.css";
interface Props {
	title: string;
	description: string;
}

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
    <head>
		<meta charset="UTF-8" />
		<meta name="description" content={Astro.props.title} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    </head>
    <body class="bg-white text-slate-800 antialiased selection:bg-gp-pinkLight selection:text-slate-900">
        <slot />
    </body>
	<script src="../scripts/main.js"></script>
</html>
<style is:global>
  /* Forzar el scroll suave en todas las capas posibles del navegador */
  :root, html {
    scroll-behavior: smooth !important;
  }

  /* Asegurar que se respete el comportamiento en cualquier dispositivo */
  @media (prefers-reduced-motion: no-preference) {
    :root, html {
      scroll-behavior: smooth !important;
    }
  }
</style>