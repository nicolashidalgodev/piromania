
<section id="contacto" class="py-20 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-12">
        <div class="lg:col-span-5 space-y-5">
            <span class="px-3 py-1 rounded-full bg-gp-pinkLight text-pink-900 text-xs font-bold uppercase tracking-wider">Contacto</span>
            <h2 class="mt-6 text-3xl sm:text-4xl font-extrabold text-slate-900">¿Tienes dudas o consultas?</h2>
            <p class="text-slate-600">Escríbenos para recibir el programa detallado de cada taller, verificar disponibilidad de cupos o consultar por clases personalizadas.</p>
            <div class="space-y-4 pt-2 text-sm">
                <p class="flex items-center gap-3"><i class="fa fa-map-marker w-5 text-pink-700"></i> Santiago, Chile</p>
                <p class="flex items-center gap-3"><i class="fa fa-envelope w-5 text-pink-700"></i><a href="mailto:natcarrasco@ug.uchile.cl" class="hover:underline">natcarrasco@ug.uchile.cl</a></p>
                <p class="flex items-center gap-3"><i class="fa fa-instagram w-5 text-pink-700"></i><a href="https://www.instagram.com/piromania.cl/" target="_blank" rel="noopener noreferrer" class="hover:underline">@piromania.cl</a></p>
            </div>
        </div>
        <div class="lg:col-span-7">
            <form id="contactForm" class="bg-slate-50 p-8 rounded-3xl border border-slate-200 soft-shadow space-y-4">
                <h3 class="text-xl font-bold text-slate-900">Escríbenos</h3>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label for="contactName" class="block text-xs font-bold text-slate-700 uppercase mb-1">Nombre completo</label>
                        <input id="contactName" name="name" type="text" required placeholder="Tu nombre" class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-gp-sage">
                    </div>
                    <div>
                        <label for="contactEmail" class="block text-xs font-bold text-slate-700 uppercase mb-1">Correo electrónico</label>
                        <input id="contactEmail" name="email" type="email" required placeholder="tu@email.com" class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-gp-sage">
                    </div>
                </div>
                <div>
                    <label for="workshopInterest" class="block text-xs font-bold text-slate-700 uppercase mb-1">Taller de interés</label>
                    <select id="workshopInterest" name="workshop" required class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-gp-sage">
                        <option value="">Selecciona un taller</option>
                        <option>Operación Juegos Diana</option>
                        <option>Vocal Gym Juvenil</option>
                        <option>Vocal Gym Adulto</option>
                        <option>Clases personalizadas</option>
                    </select>
                </div>
                <div>
                    <label for="contactMessage" class="block text-xs font-bold text-slate-700 uppercase mb-1">Mensaje / consulta</label>
                    <textarea id="contactMessage" name="message" rows="4" required placeholder="Cuéntanos en qué podemos ayudarte..." class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-gp-sage"></textarea>
                </div>
                <button type="submit" class="w-full py-3.5 rounded-xl bg-slate-900 text-white font-bold text-sm hover:bg-slate-800">Enviar mensaje</button>
            </form>
        </div>
    </div>
</section>