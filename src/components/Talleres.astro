---
import { CONTENT } from "../data/content";

const talleres = CONTENT.talleres.listado;
const claveCategoria = (categoria: string) =>
	categoria === "Escultura" ? "escultura" : "vocal";
const estiloCategoria = (categoria: string) =>
	categoria === "Escultura"
		? "bg-gp-yellow text-slate-900"
		: "bg-gp-pink text-slate-900";
---

<section id="talleres" class="py-20 bg-slate-50 border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
            <span class="px-3 py-1 rounded-full bg-gp-sageLight text-emerald-800 text-xs font-bold uppercase tracking-wider">{CONTENT.talleres.encabezado.etiqueta}</span>
            <h2 class="mt-6 text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">{CONTENT.talleres.encabezado.titulo}</h2>
            <p class="text-slate-600">{CONTENT.talleres.encabezado.descripcion}</p>
            <div class="flex flex-wrap justify-center gap-2 mt-8" id="filterContainer">
                {CONTENT.talleres.filtros.map((filtro, index) => (
                    <button
                        type="button"
                        class={`filter-btn px-4 py-2 rounded-full text-xs font-bold ${index === 0 ? "bg-slate-900 text-white" : "bg-white text-slate-700 border border-slate-200"}`}
                        data-filter-category={filtro === "Todos" ? "all" : claveCategoria(filtro)}
                    >
                        {filtro}
                    </button>
                ))}
            </div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="workshopsGrid">
            {talleres.map((taller) => (
                <article
                    class="workshop-card bg-white rounded-3xl border border-slate-200 overflow-hidden soft-shadow-hover flex flex-col"
                    data-category={claveCategoria(taller.categoria)}
                    data-modal-title={taller.nombre}
                >
                    <div class="relative h-56 overflow-hidden">
                        <img src={taller.presentacion.imagen.src} alt={taller.presentacion.imagen.alt} class="w-full h-full object-cover object-[center_15%]">
                        <span class={`absolute top-4 left-4 text-xs font-bold px-3 py-1 rounded-full shadow ${estiloCategoria(taller.categoria)}`}>
                            {taller.categoria}
                        </span>
                    </div>
                    <div class="p-6 flex-1 flex flex-col">
                        <div class="flex items-center justify-between text-xs text-slate-500 mb-2 font-medium">
                            <span><i class="fa fa-clock-o mr-1"></i> {taller.presentacion.duracion}</span>
                            <span class="text-emerald-700 font-bold">
                                {taller.cupos} cupos
                                {"publicoBreve" in taller.presentacion && ` · ${taller.presentacion.publicoBreve}`}
                            </span>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2">{taller.presentacion.titulo}</h3>
                        <p class="text-slate-600 text-sm mb-4">{taller.presentacion.descripcion}</p>
                        <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                            <span class="text-sm font-extrabold text-slate-900">{taller.presentacion.inversion}</span>
                            <div class="flex flex-wrap justify-end gap-2">
                                <button
                                    type="button"
                                    data-workshop-details={taller.detalleId}
                                    class="px-4 py-2 rounded-xl bg-gp-sageLight hover:bg-gp-sage/40 text-emerald-900 font-bold text-xs"
                                >
                                    Ver detalles
                                </button>
                                <a
                                    href={taller.detalles.inscripcion.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs"
                                >
                                    Inscribirme
                                </a>
                            </div>
                        </div>
                    </div>
                </article>
            ))}
        </div>

        {talleres.map((taller) => (
            <template id={taller.detalleId}>
                {taller.descripcion.map((parrafo) => <p class="text-slate-600">{parrafo}</p>)}

                {"aprendizajes" in taller && (
                    <>
                        <h4 class="font-bold text-slate-900">{taller.tituloAprendizajes}</h4>
                        <ul class="list-disc pl-5 text-slate-600 space-y-1">
                            {taller.aprendizajes.map((aprendizaje) => (
                                <li><strong>{aprendizaje.titulo}:</strong> {aprendizaje.descripcion}</li>
                            ))}
                        </ul>
                    </>
                )}

                {"experiencias" in taller && (
                    <>
                        <h4 class="font-bold text-slate-900">{taller.tituloExperiencias}</h4>
                        <ul class="list-disc pl-5 text-slate-600 space-y-1">
                            {taller.experiencias.map((experiencia) => (
                                <li><strong>{experiencia.titulo}:</strong> {experiencia.descripcion}</li>
                            ))}
                        </ul>
                        <h4 class="font-bold text-slate-900">{taller.aplicacion}</h4>
                        <p class="text-slate-600">{taller.aplicacionDescripcion}</p>
                    </>
                )}

                {"materialesYHerramientas" in taller && (
                    <>
                        <h4 class="font-bold text-slate-900">{taller.materialesYHerramientas.titulo}</h4>
                        <ul class="list-disc pl-5 text-slate-600 space-y-1">
                            {taller.materialesYHerramientas.indicaciones.map((indicacion) => (
                                <li><strong>{indicacion.titulo}:</strong> {indicacion.descripcion}</li>
                            ))}
                        </ul>
                    </>
                )}

                <div class="rounded-2xl bg-slate-50 border border-slate-200 p-4 text-sm text-slate-600 space-y-2">
                    <p><strong class="text-slate-900">Fechas:</strong> {taller.detalles.fechas}</p>
                    <p><strong class="text-slate-900">Horario:</strong> {taller.detalles.horario}</p>
                    {"materiales" in taller.detalles && <p><strong class="text-slate-900">Materiales:</strong> {taller.detalles.materiales}</p>}
                    {"requisitosPrevios" in taller.detalles && <p><strong class="text-slate-900">Requisitos previos:</strong> {taller.detalles.requisitosPrevios}</p>}
                    {"queLlevar" in taller.detalles && <p><strong class="text-slate-900">Qué llevar:</strong> {taller.detalles.queLlevar}</p>}
                    <p><strong class="text-slate-900">Modalidad:</strong> {taller.detalles.modalidad}</p>
                    <p><strong class="text-slate-900">Lugar:</strong> {taller.detalles.lugar}</p>
                    {"publico" in taller.detalles && <p><strong class="text-slate-900">Público:</strong> {taller.detalles.publico}</p>}
                    <p><strong class="text-slate-900">Cupos:</strong> {taller.cupos}</p>
                    <p><strong class="text-slate-900">Inversión:</strong> {taller.detalles.inversion}</p>
                </div>

                <p class="text-orange-600">{taller.detalles.inscripcion.nota}</p>
                {taller.detalles.inscripcion.url && (
                    <a
                        href={taller.detalles.inscripcion.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex justify-center px-5 py-3 rounded-xl bg-slate-900 text-white font-bold text-sm hover:bg-slate-800"
                    >
                        Ver inscripción
                    </a>
                )}
            </template>
        ))}

        <div id="workshopDetailsModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="workshopDetailsTitle" aria-hidden="true">
            <button type="button" class="modal-backdrop absolute inset-0 w-full h-full" aria-label="Cerrar detalles"></button>
            <div class="relative z-10 bg-white w-full max-w-2xl max-h-[90vh] rounded-3xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col">
                <div class="bg-slate-50 px-6 py-4 border-b border-slate-200 flex items-center justify-between gap-4">
                    <h3 id="workshopDetailsTitle" class="text-lg sm:text-xl font-extrabold text-slate-900"></h3>
                    <button id="closeWorkshopDetails" type="button" class="w-9 h-9 shrink-0 rounded-full bg-slate-200/60 hover:bg-slate-200 flex items-center justify-center text-slate-600" aria-label="Cerrar detalles">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <div id="workshopDetailsContent" class="p-6 overflow-y-auto space-y-4 text-sm leading-relaxed"></div>
            </div>
        </div>
    </div>
</section>
