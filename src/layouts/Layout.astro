---
import "../styles/main.css";
interface Props {
	title: string;
	description: string;
}

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
    <head>
		<meta charset="UTF-8" />
		<meta name="description" content={Astro.props.title} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    </head>
    <body class="bg-white text-slate-800 antialiased selection:bg-gp-pinkLight selection:text-slate-900">
        <slot />
        <script src="../scripts/main.js"></script>
    </body>
</html>