---
import { CONTENT } from "../data/content";
import PiromaniaLogo from "./PiromaniaLogo.astro";
---

<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
            <a href="#inicio" class="flex items-center gap-3 group">
                <div class="relative w-11 h-11 flex items-center justify-center">
                    <PiromaniaLogo />
                </div>
                <span>
                    <span class="text-xl font-extrabold tracking-tight text-slate-900 block leading-none">{CONTENT.encabezado.marca.nombre}</span>
                    <span class="text-xs font-semibold tracking-wider text-slate-500 uppercase">{CONTENT.encabezado.marca.subtitulo}</span>
                </span>
            </a>
            <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600" aria-label="Navegación principal">
                {CONTENT.encabezado.navegacion.map((item) => (
                    <a href={item.destino} class="hover:text-slate-900">{item.etiqueta}</a>
                ))}
            </nav>
            <a href={CONTENT.encabezado.accionPrincipal.destino} class="hidden md:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gp-pink hover:bg-[#d891a7] text-slate-900 font-bold text-sm">
                <i class="fa fa-fire"></i> {CONTENT.encabezado.accionPrincipal.etiqueta}
            </a>
            <button id="mobileMenuBtn" class="md:hidden p-2 text-slate-700" aria-label="Abrir menú">
                <i class="fa fa-bars text-2xl"></i>
            </button>
        </div>
    </div>
    <nav id="mobileMenu" class="hidden md:hidden bg-slate-50 border-b border-slate-200 px-4 pt-3 pb-6 space-y-3" aria-label="Navegación móvil">
        {CONTENT.encabezado.navegacion.map((item) => (
            <a href={item.destino} data-mobile-menu-link class="block py-2 font-semibold text-slate-700">{item.etiqueta}</a>
        ))}
    </nav>
</header>