
---
import { CONTENT } from "../data/content";
---

<footer class="bg-slate-900 text-slate-400 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-center">
        <span class="text-white font-bold">{CONTENT.plataforma.nombre}</span>
        <p class="text-xs">© <span data-current-year>{new Date().getFullYear()}</span> {CONTENT.pieDePagina.derechos}</p>
        <p class="text-xs">{CONTENT.pieDePagina.descripcion}</p>
    </div>
</footer>